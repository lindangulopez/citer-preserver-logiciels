  <projectMetadata>
    <identifier></identifier>
    <parentidentifier></parentidentifier>
    <language></language>
    <type></type>
    <title>Rewilding Portugal — Greater Côa Valley species monitoring (teaching example)</title>
    <abstract>QGIS project pairing a 30km Greater Côa Valley study-area boundary with named-site species observations and visitor-board sightings, repurposed as the worked example for the 2026-10-15 webinar 'Citer et préserver des codes et logiciels avec SWHID et CodeMeta'. Original data comes from Linda Angulo Lopez's private rewilding-illustration research project; paths here were re-pointed to data/ so the project is self-contained.</abstract>
    <keywords vocabulary="gis-teaching">
      <keyword>rewilding</keyword>
      <keyword>ecological connectivity</keyword>
      <keyword>Côa Valley</keyword>
      <keyword>species monitoring</keyword>
      <keyword>SWHID</keyword>
      <keyword>CodeMeta</keyword>
    </keywords>
    <links>
      <link description="" name="codemeta.json" size="" format="" url="https://github.com/lindangulopez/citer-preserver-logiciels/blob/main/codemeta.json" type="metadata" mimeType=""/>
    </links>
    <dates>
      <date value="2026-08-22T20:05:54" type="Created"/>
    </dates>
    <author>Linda Angulo Lopez</author>
    <creation>2026-08-22T20:05:54</creation>
  </projectMetadata>
